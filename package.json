{
  "name": "ghostlight-player",
  "version": "0.1.0",
  "description": "Ghostlight — the accessible web player for Drascula. Keyboard + screen reader, no framework.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@playwright/test": "1.49.1",
    "@types/node": "22.10.2",
    "fast-check": "3.23.2",
    "jsdom": "^25.0.1",
    "typescript": "5.7.2",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}

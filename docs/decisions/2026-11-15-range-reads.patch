diff --git a/test/worker-range.test.ts b/test/worker-range.test.ts
new file mode 100644
index 0000000..a255d27
--- /dev/null
+++ b/test/worker-range.test.ts
@@ -0,0 +1,19 @@
+// The hosting Worker's Content-Range helper for R2 range reads of the big
+// game-data files (Packet.001, queen.1).
+import { describe, expect, it } from "vitest";
+import { contentRange } from "../web/src/range";
+
+describe("contentRange", () => {
+  it("gives offset and length as an inclusive byte range", () => {
+    expect(contentRange({ offset: 100, length: 100 }, 32847563)).toBe("bytes 100-199/32847563");
+  });
+  it("runs an open-ended range to the last byte", () => {
+    expect(contentRange({ offset: 262144 }, 1000000)).toBe("bytes 262144-999999/1000000");
+  });
+  it("clamps a range that runs past the end", () => {
+    expect(contentRange({ offset: 900, length: 500 }, 1000)).toBe("bytes 900-999/1000");
+  });
+  it("handles a suffix range", () => {
+    expect(contentRange({ suffix: 10 }, 1000)).toBe("bytes 990-999/1000");
+  });
+});

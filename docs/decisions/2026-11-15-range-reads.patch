+// Content-Range for an R2 range read (the shape of R2Range), kept free of
+// Workers types so the unit tests can import it.
+
+export type ByteRange = { offset?: number; length?: number } | { suffix: number };
+
+/** The Content-Range value for a range read of an object of `size` bytes. */
+export function contentRange(range: ByteRange, size: number): string {
+  let start: number;
+  let end: number;
+  if ("suffix" in range) {
+    start = Math.max(0, size - range.suffix);
+    end = size - 1;
+  } else {
+    start = range.offset ?? 0;
+    end = range.length !== undefined ? Math.min(size, start + range.length) - 1 : size - 1;
+  }
+  return `bytes ${start}-${end}/${size}`;

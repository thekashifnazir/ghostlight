{
  // Ghostlight hosting (web-build Requirement 5).
  //
  // A Cloudflare Worker with static assets serves the page, the ScummVM wasm
  // and loader, translations, themes, the HTTP-filesystem index.json listings
  // and the small game-data files. The one oversized file, Packet.001 (32.8 MB,
  // over Cloudflare's 25 MiB static-asset limit), is served from an R2 bucket
  // through the Worker. See .kiro/specs/web-build/design.md.
  //
  // This file is reviewable text and holds NO secret. Cloudflare credentials
  // are supplied at deploy time (`wrangler login` or CLOUDFLARE_API_TOKEN in
  // the environment) and are referenced by name only, never committed.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ghostlight",
  "main": "src/index.ts",
  // Set to the date the Worker was authored; bump deliberately, not on a whim.
  "compatibility_date": "2026-11-06",
  "assets": {
    // The build output from scripts/build-web.sh, MINUS Packet.001 (which goes
    // to R2). The deploy step (see DEPLOY.md) copies
    // vendor/scummvm-web/build-emscripten/ into ./public/ and removes
    // Packet.001 before `wrangler deploy`. ./public/ is gitignored: it is build
    // output and game data, never committed.
    "directory": "./public/",
    "binding": "ASSETS",
    // Invoke the Worker first so it can intercept the Packet.001 path and serve
    // it from R2; everything else the Worker forwards to the static-assets
    // layer via env.ASSETS.fetch(request).
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      // The Worker reads Packet.001 from this bucket. The bucket is created and
      // populated at deploy time (see DEPLOY.md); no game data is committed.
      "binding": "GAME_DATA",
      "bucket_name": "ghostlight-game-data"
    }
  ]
}

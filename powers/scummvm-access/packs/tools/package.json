{
  "name": "@scummvm-access/pack-tools",
  "version": "1.0.0",
  "description": "Validator and coverage checker for ScummVM accessibility packs (format v1). Bundled in the scummvm-access power.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pack-validate": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "validate": "tsx src/cli.ts validate",
    "check-coverage": "tsx src/cli.ts check-coverage"
  },
  "dependencies": {
    "ajv": "8.17.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}

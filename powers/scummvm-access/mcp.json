{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "drascula": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "tsx", "src/server.ts"],
      "cwd": "${PLUGIN_DATA}/drascula-mcp",
      "env": {
        "DRASCULA_MCP_TRANSPORT": "replay",
        "DRASCULA_MCP_FIXTURE": "tavern"
      }
    }
  }
}

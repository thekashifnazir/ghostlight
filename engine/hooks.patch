index 34526326dc..b5e3812dff 100644
--- a/engines/drascula/animation.cpp
+++ b/engines/drascula/animation.cpp
@@ -20,6 +20,7 @@
  */
 
 #include "drascula/drascula.h"
+#include "drascula/a11y.h"
 
 #include "common/text-to-speech.h"
 
@@ -1715,6 +1716,9 @@ void DrasculaEngine::animation_9_6() {
 	updateRoom();
 	updateScreen();
 	talk(301);
+	// The ending's last line is done and the credits follow.
+	if (_a11y)
+		_a11y->onGameEnd();
 	v_cd = _mixer->getVolumeForSoundType(Audio::Mixer::kMusicSoundType) / 16;
 	v_cd += 4;
 	playMusic(17);

diff --git a/engines/drascula/drascula.h b/engines/drascula/drascula.h
index 6784cf39c0..bf708e3897 100644
--- a/engines/drascula/drascula.h
+++ b/engines/drascula/drascula.h
@@ -335,7 +335,15 @@ static const int interf_y[] = { 51, 51, 51, 51, 83, 83, 83 };
 
 struct RoomHandlers;
 
+// Accessibility layer, see a11y.h.
+class A11yLayer;
+
 class DrasculaEngine : public Engine {
+	// The accessibility layer reads private state such as the text and
+	// room-action tables.
+	friend class A11yLayer;
+	// The live accessibility layer, or nullptr. Set by the layer itself.
+	A11yLayer *_a11y;
 protected:
 	// Engine APIs
 	Common::Error run() override;
diff --git a/engines/drascula/graphics.cpp b/engines/drascula/graphics.cpp
index d39d58f6f0..2b5df73420 100644
--- a/engines/drascula/graphics.cpp

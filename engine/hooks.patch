 void DrasculaEngine::centerText(const char *message, int textX, int textY) {
+	// Ghostlight: centerText() is the single chokepoint every on-screen text
+	// line passes through — spoken dialogue (talk.cpp), narration/cutscene text
+	// (animation.cpp), system messages (interface.cpp) and hover/examine text
+	// (moveCursor) all call it with the whole line. Hand the full message to the
+	// a11y layer so it emits A11Y_TEXT (R6.2); the layer de-duplicates the
+	// per-frame redraw so each line is reported once. Guarded on _a11y so it is
+	// a no-op when no layer is live.
+	if (_a11y)
+		_a11y->onText(message);
+
 	char msg[200];
 	Common::strlcpy(msg, message, 200);
 

 #include "graphics/surface.h"
 
 #include "common/stream.h"
@@ -360,6 +361,10 @@ bool DrasculaEngine::textFitsCentered(char *text, int x) {
 }
 
 void DrasculaEngine::centerText(const char *message, int textX, int textY) {
+	// Every on-screen line passes through here whole: report it.
+	if (_a11y)
+		_a11y->onText(message);
+
 	char msg[200];
 	Common::strlcpy(msg, message, 200);
 
diff --git a/backends/platform/sdl/emscripten/emscripten.cpp b/backends/platform/sdl/emscripten/emscripten.cpp
--- a/backends/platform/sdl/emscripten/emscripten.cpp
+++ b/backends/platform/sdl/emscripten/emscripten.cpp
@@ -226,11 +226,24 @@
 		return;
 	}
 #ifdef ENABLE_EVENTRECORDER
-	if (!g_eventRec.processDelayMillis())
+	if (g_eventRec.processDelayMillis()) {
+		((EmscriptenTimerManager *)_timerManager)->checkTimers();
+		lastSleep = getMillis();
+		return;
+	}
 #endif
-	SDL_Delay(msecs);
-
-	((EmscriptenTimerManager *)_timerManager)->checkTimers();
+	// Ghostlight: sleep in slices of at most 10 ms and run the timers after
+	// each one. The Emscripten mixer makes its audio in a timer proc, and the
+	// timers only run here, so one long sleep starved it: Drascula's credits
+	// wait 1 s per frame, and only about 0.1 s of each second played.
+	const uint32 start = getMillis();
+	uint32 elapsed = 0;
+	do {
+		const uint slice = msecs - elapsed < 10 ? msecs - elapsed : 10;
+		SDL_Delay(slice);
+		((EmscriptenTimerManager *)_timerManager)->checkTimers();
+		elapsed = getMillis() - start;
+	} while (elapsed < msecs);
 	lastSleep = getMillis();
 }
 

 namespace Drascula {
 
@@ -70,6 +71,9 @@ DrasculaEngine::DrasculaEngine(OSystem *syst, const DrasculaGameDescription *gam
 	_talkSequences = nullptr;
 	_currentSaveSlot = 0;
 
+	// Set by the A11yLayer that runCurrentChapter() keeps on its stack.
+	_a11y = nullptr;
+
 	term_int = 0;
 	currentChapter = 0;
 	_loadedDifferentChapter = false;
@@ -416,6 +420,10 @@ bool DrasculaEngine::runCurrentChapter() {
 	int n;
 	int framesWithoutAction = 0;
 
+	// Accessibility layer for this chapter: reports state and runs commands
+	// from a file. On the stack so it covers chapter setup and the main loop.
+	A11yLayer _a11y(this);
+
 	_rightMouseButton = 0;
 	_leftMouseButtonHeld = false;
 
@@ -447,8 +455,12 @@ bool DrasculaEngine::runCurrentChapter() {
 	if (currentChapter == 1) {
 		pickObject(28);
 
+		// Skip the chapter 1 intro, which sets no flags. GHOSTLIGHT_PLAY_INTRO
+		// keeps it for a sighted run.
+#ifdef GHOSTLIGHT_PLAY_INTRO
 		if (!_loadedDifferentChapter)
 			animation_1_1();
+#endif
 
 		selectVerb(kVerbNone);
 		loadPic("2aux62.alg", drawSurface2);
@@ -550,7 +562,15 @@ bool DrasculaEngine::runCurrentChapter() {
 
 	showCursor();
 
+	// The first room is live: report it. Also covers a --save-slot launch.
+	_a11y.onStartup();
+
 	while (!shouldQuit()) {
+		// Runs at most one queued command. True means the command ended the
+		// chapter, as `if (verify1()) return true;` below does for a door click.
+		if (_a11y.poll())
+			return true;
+
 		if (!_characterMoved) {
 			stepX = STEP_X;
 			stepY = STEP_Y;
@@ -900,6 +920,11 @@ void DrasculaEngine::updateEvents() {
 			break;
 		}
 	}
+
+	// This pump runs inside the speech and cutscene loops, where poll()
+	// does not, so a queued `skip` is honoured here.
+	if (_a11y)
+		_a11y->onUpdateEvents();
 }
 

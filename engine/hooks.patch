# engine/hooks.patch — hooks into the pinned ScummVM Drascula engine.
#
# Small, readable edits to the engine's own sources, applied by
# scripts/build-engine.sh with `git apply` against vendor/scummvm. The work
# itself lives in engine/a11y.cpp (copied in by the build script); these hunks
# are only the few lines that construct the A11yLayer and call into it.
#
# Lines starting with `#` above the first `diff` line are comments and are
# ignored by git apply. The build script treats a file with no diff hunks as
# "nothing to apply".
#
# Task 3 hooks (drascula.cpp):
#   * include drascula/a11y.h
#   * construct A11yLayer on the stack at the top of runCurrentChapter(), so it
#     is in scope for both chapter setup and the per-frame main loop
#   * hard-code the intro skip: animation_1_1() is guarded out (R1.4)
#   * call _a11y.onStartup() once the first playable room is entered, to assert
#     subtitles and emit the first A11Y room-state line (R1.4, R6.1)
#
# Task 4 hook (drascula.cpp):
#   * call _a11y.poll() once per frame at the top of the main loop. For now
#     poll() watches for a room/chapter change and re-emits the A11Y room-state
#     line, so the line prints on every room change (R1.1). The transition
#     itself happens in exitRoom()/enterRoom() (rooms.cpp, not patched); control
#     returns to the main loop once the move settles, so detecting the change in
#     poll() keeps all engine hooks in drascula.cpp (R10.2). The command reader
#     and A11Y_DIFF build on this same per-frame entry point in later tasks.
#
# Task 13 hook (drascula.h):
#   * declare `friend class A11yLayer;` on DrasculaEngine. The a11y layer reads
#     the engine's own data to observe state and reproduce its actions. Most of
#     what it needs is public (the room/inventory/flag arrays), but the `inv`
#     listing's "look at it" line (R6.4) comes from the engine's text and
#     room-action tables (`_text`, `_roomActions`, `_roomActionsSize`), which
#     are private. One `friend` line lets the layer READ those exactly as the
#     engine's own roomParse(200) does, rather than duplicating game data or
#     fabricating look lines. It grants no new behaviour — the layer still only
#     calls the engine's own methods — and keeps the patch a single readable
#     line instead of widening the engine's public surface.
#
# Later tasks add hooks for converse.cpp (A11Y_CHOICES / choose) and
# graphics.cpp (A11Y_TEXT); they will extend this patch.
diff --git a/engines/drascula/drascula.h b/engines/drascula/drascula.h
index 6784cf39c0..87d121dc0d 100644
--- a/engines/drascula/drascula.h
+++ b/engines/drascula/drascula.h
@@ -336,6 +336,10 @@ static const int interf_y[] = { 51, 51, 51, 51, 83, 83, 83 };
 struct RoomHandlers;
 
 class DrasculaEngine : public Engine {
+	// Ghostlight a11y layer: reads the engine's own state (including the
+	// private text/room-action tables used for item look lines, R6.4) and
+	// drives the game through the engine's own methods. See engine/a11y.cpp.
+	friend class A11yLayer;
 protected:
 	// Engine APIs
 	Common::Error run() override;
diff --git a/engines/drascula/drascula.cpp b/engines/drascula/drascula.cpp
index aeccc822cb..4fcfdea637 100644
--- a/engines/drascula/drascula.cpp
+++ b/engines/drascula/drascula.cpp
@@ -33,6 +33,7 @@
 
 #include "drascula/drascula.h"
 #include "drascula/console.h"
+#include "drascula/a11y.h"
 
 namespace Drascula {
 
@@ -416,6 +417,12 @@ bool DrasculaEngine::runCurrentChapter() {
 	int n;
 	int framesWithoutAction = 0;
 
+	// Ghostlight a11y layer: observes room/inventory/flag state, drives the
+	// game from a command file and emits A11Y* log lines. Lives on the stack
+	// for this chapter so it is in scope for both the chapter setup (intro
+	// skip, first room state) and the per-frame poll() in the main loop.
+	A11yLayer _a11y(this);
+
 	_rightMouseButton = 0;
 	_leftMouseButtonHeld = false;
 
@@ -447,8 +454,15 @@ bool DrasculaEngine::runCurrentChapter() {
 	if (currentChapter == 1) {
 		pickObject(28);
 

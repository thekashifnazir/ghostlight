+		// choice) and, if a `choose`/`choices` is queued, act on it — a `choose`
+		// sets _mouseY/_leftMouseButton here so the engine's own selection below
+		// fires for that option this frame (R7.1, R7.2, R6.3).
+		if (_a11y)
+			_a11y->onConverseFrame(phrase1, phrase2, phrase3, phrase4,
+			                       game1, game2, game3,
+			                       phrase1_bottom, phrase2_bottom, phrase3_bottom, phrase4_bottom);
+
 		if (_mouseY > 0 && _mouseY < phrase1_bottom) {
 			if (game1 == kDialogOptionClicked && _color != kColorWhite)
 				color_abc(kColorWhite);
@@ -302,6 +321,12 @@ void DrasculaEngine::converse(int index) {
 		updateScreen();
 	} // while (breakOut == 0)
 
+	// Ghostlight: the conversation has ended (option 4 or breakOut). Tell the
+	// layer so `choices`/`choose` go back to "no conversation open" and the
+	// per-conversation state is cleared for the next one (R7.2).
+	if (_a11y)
+		_a11y->onConverseEnd();
+
 	if (currentChapter == 2)
 		loadPic(menuBackground, backSurface);
 	else

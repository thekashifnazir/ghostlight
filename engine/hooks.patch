 		selectVerb(kVerbNone);
 		loadPic("2aux62.alg", drawSurface2);
@@ -550,7 +564,19 @@ bool DrasculaEngine::runCurrentChapter() {
 
 	showCursor();
 
+	// Ghostlight: the chapter is now set up and the first playable room entered,
+	// so assert subtitles are on and emit the first A11Y room-state line (R1.4,
+	// R6.1). Runs once per chapter start, which also covers a --save-slot launch.

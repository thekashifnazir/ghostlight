 #include "common/text-to-speech.h"
 
@@ -214,6 +215,11 @@ void DrasculaEngine::converse(int index) {
 	sayText(ttsPhrase3, Common::TextToSpeechManager::QUEUE);
 	sayText(ttsPhrase4, Common::TextToSpeechManager::QUEUE);
 
+	// poll() does not run inside this modal loop, so the layer services
+	// `choices` and `choose` from here.
+	if (_a11y)
+		_a11y->onConverseBegin();
+
 	while (breakOut == 0 && !shouldQuit()) {
 		updateRoom();
 
@@ -235,6 +241,14 @@ void DrasculaEngine::converse(int index) {
 		phrase3_bottom = phrase2_bottom + 8 * print_abc_opc(phrase3, phrase2_bottom + 2, game3);
 		phrase4_bottom = phrase3_bottom + 8 * print_abc_opc(phrase4, phrase3_bottom + 2, kDialogOptionUnselected);
 
+		// The option bands are laid out: list the choices, and apply a queued
+		// `choose` by setting _mouseY and the left button before the selection
+		// test below.
+		if (_a11y)
+			_a11y->onConverseFrame(phrase1, phrase2, phrase3, phrase4,
+			                       game1, game2, game3,
+			                       phrase1_bottom, phrase2_bottom, phrase3_bottom, phrase4_bottom);
+
 		if (_mouseY > 0 && _mouseY < phrase1_bottom) {
 			if (game1 == kDialogOptionClicked && _color != kColorWhite)
 				color_abc(kColorWhite);
@@ -302,6 +316,10 @@ void DrasculaEngine::converse(int index) {
 		updateScreen();
 	} // while (breakOut == 0)
 
+	// Conversation over (option 4 or breakOut).
+	if (_a11y)
+		_a11y->onConverseEnd();
+
 	if (currentChapter == 2)
 		loadPic(menuBackground, backSurface);
 	else
